{
  "name": "ultimate-diploma-cicd",

  // подключаем основной compose-файл + override
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.codespace.yml"
  ],

  // имя сервиса, который станет рабочей средой VS Code
  "service": "sample-flask",
  "workspaceFolder": "/code",

  // автоматический форвард порта приложения
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Flask Web UI",
      "onAutoForward": "openPreview"
    }
  },

  // если нужны дополнительные Python‑зависимости
  "postCreateCommand": "pip install --upgrade pip && pip install -r /code/requirements.txt",

  "remoteUser": "root",

  // рекомендуемые расширения VS Code (новый синтаксис)
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
