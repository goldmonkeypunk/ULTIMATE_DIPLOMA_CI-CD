{
  "name": "ultimate-diploma-cicd",

  // основной compose + override
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.codespace.yml"
  ],

  // этот сервис станет dev-container’ом
  "service": "sample-flask",

  // НЕ переписывать команду — запускаем то, что указано в compose-файле
  "overrideCommand": false,

  // рабочая папка
  "workspaceFolder": "/code",

  // автопроброс порта
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Flask Web UI",
      "onAutoForward": "openPreview"
    }
  },

  // дополнительные зависимости (если нужны)
  "postCreateCommand": "pip install --upgrade pip && pip install -r /code/requirements.txt",

  "remoteUser": "root",

  // рекомендованные расширения
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
