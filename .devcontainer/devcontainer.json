{
  "name": "ultimate-diploma-cicd",
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "docker-compose.codespace.yml"
  ],
  "service": "sample-flask",
  "overrideCommand": false,
  "workspaceFolder": "/code",

  "forwardPorts": [5002],
  "portsAttributes": {
    "5002": {
      "label": "Flask Web UI",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install -r /code/requirements.txt",
  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
